DirectoryIndex index.php

# Fase 1: site institucional de página única (index.php).
# Reservado para futuras fases (não ativo ainda):
#   RewriteRule ^eventos/([a-z0-9-]+)/?$ eventos/index.php?slug=$1 [QSA,L]
#   RewriteRule ^loja/?$ loja/index.php [QSA,L]
#   RewriteRule ^produto/([a-z0-9-]+)/?$ loja/produto.php?slug=$1 [QSA,L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
